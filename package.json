{
  "name": "acn-portfolio-simulator",
  "version": "1.1.0",
  "private": true,
  "description": "ACN Portfolio Simulator — private planning workspace (paper portfolio, projections, downside). No brokerage connection.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/server.js",
    "create-user": "node scripts/create-user.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js",
    "test:all": "npm test && npm run test:browser"
  }
}
